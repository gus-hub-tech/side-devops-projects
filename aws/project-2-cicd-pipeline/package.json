{
  "name": "my-aws-webapp",
  "version": "1.0.0",
  "description": "DevOps web app with AWS deployment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:coverage": "c8 node --test"
  },
  "c8": {
    "all": true,
    "include": [
      "app.js",
      "server.js"
    ],
    "exclude": [
      "test/**"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "reports-dir": "coverage"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "supertest": "^7.3.2"
  }
}
