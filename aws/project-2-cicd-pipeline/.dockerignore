# Keep the image's npm-built node_modules; don't overlay the host copy.
node_modules

# Never ship VCS data or local logs.
.git
.gitignore
npm-debug.log*
*.log

# Image/build inputs aren't needed at runtime.
Dockerfile
.dockerignore
README.md
aws-script/

# Tests, test fixtures, coverage output, and IaC aren't needed in the image.
test
*.test.js
coverage
terraform
